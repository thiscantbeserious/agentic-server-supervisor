# Copy to .env and fill in. .env is gitignored and should be chmod 0600.
#
#   cd deploy && cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# Every variable compose interpolates appears here. A `:?` variable that is
# unset makes `docker compose up` fail immediately — fail fast beats a container
# that silently cannot authenticate.

# ---------------------------------------------------------------------------
# T1 — notification stack (needed now)
# ---------------------------------------------------------------------------

# From @BotFather. This token can send messages as your bot: treat it as a
# credential, never commit it, and keep it out of the sentinel container.
TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# Your chat id. For a personal chat this is a positive integer; for a group it
# is negative (e.g. -1001234567890). Ask @userinfobot if unsure.
TELEGRAM_CHAT_ID=123456789

# mailrise enforces SMTP AUTH unconditionally. These are the credentials OMV,
# smartd and ZED will use to hand mail to mailrise — invent them here, then
# configure the same pair on the host in T8.
MAILRISE_SMTP_USER=sentinel
MAILRISE_SMTP_PASS=change-me-a-long-random-string

# Interfaces the two services bind to. 127.0.0.1 keeps them host-local; widen
# to the LAN address (e.g. 192.168.1.151) only when other machines must deliver
# mail here. Never 0.0.0.0 — the apprise endpoint can send messages as you.
APPRISE_BIND=127.0.0.1
MAILRISE_BIND=127.0.0.1

# uid/gid the apprise container runs its config volume as.
APPRISE_PUID=1000
APPRISE_PGID=1000

TZ=UTC

# ---------------------------------------------------------------------------
# T7/T8 — sentinel service. Not used by the T1 stack; listed so .env is complete
# when the supervisor service is added (contracts/runtime.md R3).
# ---------------------------------------------------------------------------

# Image tag to run.
SENTINEL_TAG=latest

# Numeric gid of the host's systemd-journal group, so the unprivileged
# container may read the journal. install.sh writes it; on bam it is 999.
JOURNAL_GID=999

# Directory holding agy's OAuth credentials on the host, mounted read-only at
# /run/secrets/agy. The container never writes back: re-authenticate on the
# host and restart sentinel.
AGY_CREDENTIALS_DIR=/home/doh/.gemini

# Where the supervisor's own SMTP fallback is addressed. Must match a config
# key in mailrise/mailrise.conf.
SENTINEL_MAIL_FROM=sentinel@mailrise.xyz
SENTINEL_MAIL_TO=sentinel@mailrise.xyz

# Log level: DEBUG | INFO | WARN | ERROR. Validated at startup — a typo exits 78.
LOG_LEVEL=INFO
