#cloud-config
# NoCloud seed for both VM variants. __SSH_PUBKEY__ is substituted by the
# calling script (a fresh keypair generated per run, never committed,
# never reused between runs).
users:
  - name: e2e
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - __SSH_PUBKEY__
ssh_pwauth: false
package_update: false
growpart:
  mode: auto
  devices: ["/"]
runcmd:
  - [ systemctl, enable, --now, ssh ]
  # Makes "no working NIC" a positive statement instead of an absence: an
  # unreachable-VM diagnosis used to grep the console log for DHCP/link
  # lines and had to treat finding none as merely suggestive, not every
  # network stack logs to the console. This prints the guest's own view of
  # its addresses and listening sockets unconditionally.
  - [ sh, -c, "echo '=== console-netinfo ==='; ip -br addr; ss -ltn; echo '=== console-netinfo end ==='" ]
